#!/usr/bin/env bash
# waybar-switch - Switch between Waybar templates/modes

set -e

THEME_DIR="$HOME/dotfiles/.config/waybar/templates"
CONFIG="$HOME/dotfiles/.config/waybar/config.jsonc"

if [[ $# -eq 0 ]]; then
    echo "Usage: waybar-switch [top|bottom|summitsplit]"
    echo "Available modes:"
    ls "$THEME_DIR"/*.jsonc | xargs -n1 basename .jsonc
    exit 1
fi

MODE="$1"
TEMPLATE="$THEME_DIR/${MODE}.jsonc"

if [[ ! -f "$TEMPLATE" ]]; then
    echo "Template '$MODE' not found!"
    echo "Available: $(ls "$THEME_DIR"/*.jsonc | xargs -n1 basename .jsonc)"
    exit 1
fi

# Backup current config
cp "$CONFIG" "$CONFIG.bak.$(date +%s)"

# Copy template to main config
cp "$TEMPLATE" "$CONFIG"

# Reload Waybar
pkill waybar 2>/dev/null || true
sleep 0.5
setsid waybar >/dev/null 2>&1 & disown

echo "✓ Switched to mode: $MODE"
echo "Config: $CONFIG"
echo "From: $TEMPLATE"