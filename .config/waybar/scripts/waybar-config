#!/usr/bin/env python3
"""waybar-config - Daftar lengkap konfigurasi Waybar beserta fungsinya.

Pemakaian:
    waybar-config --print    → Cetak semua konfigurasi ke terminal
    waybar-config --list     → List only nama modul dan deskripsi
    waybar-config --search "keyword"  → Filter konfigurasi berdasarkan kata kunci
"""

import json, os, subprocess, sys

CONFIG_PATH = os.path.expanduser("~/.config/waybar/config.jsonc")

def load_config():
    with open(CONFIG_PATH) as f:
        return json.load(f)

def format_config_tree(config, prefix="", indent=2):
    """Rekursif format config JSON menjadi tree yang readable."""
    lines = []
    for key, value in config.items():
        full_key = f"{prefix}{key}"
        if isinstance(value, dict):
            lines.append(f"📁 {full_key}/")
            for k, v in value.items():
                lines.extend(format_config_tree({k: v}, prefix=f"{full_key}.", indent=indent))
        elif isinstance(value, list):
            lines.append(f"📋 {full_key}/")
            for i, item in enumerate(value):
                if isinstance(item, str) and item.startswith("${") or item.startswith("~"):
                    lines.append(f"   └── item {i}: {item}")
                else:
                    lines.append(f"   └── item {i}: {type(item).__name__}")
        elif isinstance(value, (int, float, bool)):
            lines.append(f"🔢 {full_key} = {value}")
        elif isinstance(value, str):
            # Singkatkan string panjang
            if len(value) > 60:
                display = value[:60] + "..."
            else:
                display = value
            lines.append(f"📝 {full_key} = \"{display}\"")
        else:
            lines.append(f"❓ {full_key} = {type(value).__name__}")
    return lines

def main():
    if len(sys.argv) < 2:
        print("Usage: waybar-config --print | --list | --search <keyword>")
        sys.exit(1)

    config = load_config()

    action = sys.argv[1]

    if action == "--print":
        # Print seluruh konfigurasi dalam format tree
        print(f"=== Waybar Configuration ({len(config)} top-level keys) ===\n")
        for line in format_config_tree(config):
            print(line)
        print("\n" + "="*60)
        print("Catat: Edit file ~/.config/waybar/config.jsonc untuk mengubah")
        print("Setelah mengedit, restart waybar: pkill waybar && waybar")

    elif action == "--list":
        # Hanya list modul-modul utama dan fungsinya
        print("=== MODUL UTAMA WAYBAR ===\n")
        modules = {
            "custom/logo": "Icon Symphony + klik kanan ke rofi beats",
            "mpris": "Musik player (previous/pause/next)",
            "workspaces": "Daftar workspace Hyprland",
            "backlight": "Kecerahan layar (scroll ubah)",
            "disk": "Penyimpanan (disk C:)",
            "cpu": "Pengguna CPU (klick btop)",
            "memory": "Memori RAM (klick btop)",
            "battery": "Baterai (klick power-profiles)",
            "bluetooth": "Status Bluetooth",
            "pulseaudio": "Volume (klick pavucontrol)",
            "tray": "Area notifikasi aplikasi",
            "network": "Koneksi jaringan/WiFi",
            "clock": "Waktu & Tanggal"
        }
        for mod, desc in modules.items():
            print(f"  {mod:30s} → {desc}")
        print("\n" + "="*60)
        print("Ganti modul: edit modules-left/modules-center/modules-right di config.jsonc")

    elif action == "--search":
        if len(sys.argv) < 3:
            print("Gunakan: waybar-config --search <keyword>")
            sys.exit(1)
        keyword = sys.argv[2].lower()
        print(f"=== Mencari: \"{keyword}\" ===\n")
        found = False
        for key, value in config.items():
            key_str = str(key).lower()
            val_str = json.dumps(value).lower()
            if keyword in key_str or keyword in val_str:
                found = True
                # Print kunci dan nilai singkat
                val_preview = json.dumps(value)[:80] + "..." if len(json.dumps(value)) > 80 else json.dumps(value)
                print(f"  {key}: {val_preview}")
        if not found:
            print(f"Tidak ditemukan konfigurasi untuk: \"{keyword}\"")
        print("\n" + "="*60)

    else:
        print("Aksi tidak dikenal. Gunakan --print, --list, atau --search")
        sys.exit(1)

if __name__ == "__main__":
    main()